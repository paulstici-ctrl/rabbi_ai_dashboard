{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RABBIT Command Center contract: scanner",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "mode": {
      "type": "string",
      "enum": [
        "demo",
        "live-readonly"
      ]
    },
    "generated_utc": {
      "type": "string"
    },
    "as_of_utc": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "opportunities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "symbol": {
            "type": "string"
          },
          "timeframe": {
            "type": "string",
            "enum": [
              "M1",
              "M5",
              "M15",
              "H1",
              "H4"
            ]
          },
          "setup": {
            "type": "string"
          },
          "direction": {
            "type": "string",
            "enum": [
              "BUY",
              "SELL",
              "NEUTRAL"
            ]
          },
          "score": {
            "type": "number"
          },
          "score_kind": {
            "type": "string",
            "const": "heuristic"
          },
          "status": {
            "type": "string",
            "enum": [
              "WATCH",
              "ARMED",
              "BLOCKED"
            ]
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "symbol",
          "timeframe",
          "setup",
          "direction",
          "score",
          "score_kind",
          "status",
          "note"
        ],
        "additionalProperties": false
      },
      "maxItems": 200
    }
  },
  "required": [
    "schema_version",
    "mode",
    "generated_utc",
    "as_of_utc",
    "source",
    "opportunities"
  ],
  "additionalProperties": false
}
